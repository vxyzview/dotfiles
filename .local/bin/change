set -euo pipefail

readonly QTHEME_DIR="$HOME/.qtheme"
readonly WALLPAPER_DIR="$HOME/.wallpaper"

# Validate required directories and commands upfront
_preflight() {
    local missing=0
    for dir in "$QTHEME_DIR" "$WALLPAPER_DIR"; do
        [[ -d "$dir" ]] || { echo "Error: Directory '$dir' not found."; missing=1; }
    done
    for cmd in rofi feh gsettings qtile xdg-user-dirs-update xdg-user-dirs-gtk-update; do
        command -v "$cmd" &>/dev/null || { echo "Error: '$cmd' not found in PATH."; missing=1; }
    done
    (( missing )) && exit 1
}

apply_theme() {
    local selected_theme="$1"
    local src_path="$QTHEME_DIR/$selected_theme"

    [[ -d "$src_path" ]] || { echo "Error: Theme directory '$src_path' not found."; exit 1; }

    # Copy theme files
    cp -r "$src_path/"* "$HOME/.config/"

    # Apply GTK + icon theme in parallel
    case $selected_theme in
        redrose) gsettings set org.gnome.desktop.interface gtk-theme  "adw-gtk3-red"  &
                 gsettings set org.gnome.desktop.interface icon-theme "Tela-red"      & ;;
        bluerod) gsettings set org.gnome.desktop.interface gtk-theme  "adw-gtk3-blue" &
                 gsettings set org.gnome.desktop.interface icon-theme "Tela-purple"   & ;;
        nyoom)   gsettings set org.gnome.desktop.interface gtk-theme  "adw-gtk3-dark" &
                 gsettings set org.gnome.desktop.interface icon-theme "Tela-black"    & ;;
    esac
    wait
}

select_wallpaper() {
    local selected_wallpaper
    selected_wallpaper=$(ls "$WALLPAPER_DIR" | rofi -dmenu -p "Select Wallpaper:")

    if [[ -n "$selected_wallpaper" ]]; then
        feh --bg-fill "$WALLPAPER_DIR/$selected_wallpaper"
        echo "Wallpaper '$selected_wallpaper' set."
    else
        echo "No wallpaper selected. Keeping current."
    fi

    # Update XDG dirs and kill stale processes in parallel
    xdg-user-dirs-update &
    xdg-user-dirs-gtk-update &
    kill $(pidof xsettingsd alacritty firefox dunst thunar ksuperkey 2>/dev/null) 2>/dev/null &

    wait

    qtile cmd-obj -f restart
}

select_theme() {
    local selected_theme
    selected_theme=$(ls "$QTHEME_DIR" | rofi -dmenu -p "Select Theme:")

    [[ -n "$selected_theme" ]] || { echo "No theme selected. Exiting."; exit 1; }

    apply_theme "$selected_theme"
    select_wallpaper
}

_preflight
select_theme
