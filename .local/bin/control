# Constants
readonly NOTIFY_ID=424242
readonly STACK_TAG=progress
readonly ICON_DIR="$HOME/.notify/images"
readonly ICON_VOLUME="$ICON_DIR/music.png"
readonly ICON_MUTE="$ICON_DIR/mute.png"
readonly ICON_BRIGHTNESS="$ICON_DIR/smart-bulb.png"

# Unified notification dispatcher — value and icon passed directly, no re-querying
notify() {
    local title="$1" message="$2" value="$3" icon="$4"
    dunstify -u low -i "$icon" -r "$NOTIFY_ID" \
        -h int:value:"$value" \
        -h string:x-dunst-stack-tag:"$STACK_TAG" \
        "$title" "$message  $value"
}

change_brightness() {
    brightnessctl -q s "$1"
    # Use cached values from a single brightnessctl call — avoids two forks
    read -r cur max < <(brightnessctl | awk '/Current/ {cur=$4} /Max/ {max=$4} END {gsub(/[^0-9]/,"",cur); gsub(/[^0-9]/,"",max); print cur, max}')
    notify "Brightness" "Now" "$(( cur * 100 / max ))" "$ICON_BRIGHTNESS"
}

change_volume() {
    pactl set-sink-volume @DEFAULT_SINK@ "$1%"
    # pactl get-sink-volume is far faster than 'pactl list sinks | awk'
    local vol
    vol=$(pactl get-sink-volume @DEFAULT_SINK@ | awk '{print $5; exit}')
    notify "Volume" "Now" "${vol%%%*}" "$ICON_VOLUME"
}

toggle_mute() {
    pactl set-sink-mute @DEFAULT_SINK@ toggle
    # pactl get-sink-mute is a single fast query vs the full 'list sinks' parse
    if [[ $(pactl get-sink-mute @DEFAULT_SINK@) == *yes* ]]; then
        notify "Volume" "Muted" "0" "$ICON_MUTE"
    else
        local vol
        vol=$(pactl get-sink-volume @DEFAULT_SINK@ | awk '{print $5; exit}')
        notify "Volume" "Unmuted" "${vol%%%*}" "$ICON_VOLUME"
    fi
}

# Argument dispatch
case "$1" in
    brightness) [[ -n "$2" ]] && change_brightness "$2" || { echo "Usage: $0 brightness <value>"; exit 1; } ;;
    volume)     [[ -n "$2" ]] && change_volume     "$2" || { echo "Usage: $0 volume <value>";     exit 1; } ;;
    mute)       toggle_mute ;;
    *)          echo "Usage: $0 <brightness|volume|mute> [value]"; exit 1 ;;
esac
